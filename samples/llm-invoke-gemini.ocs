⫻protocol/ocs:
  Context:
    ⫻context/klmx: KickLang-v4.1 / QML6 Engine
    ⫻context/node: OCS/Display · Berlin Node
  Directives:
    ⫻cmd/mode: Fluid QML6 Pipeline
    ⫻cmd/llm: stream
  Payloads:
    ⫻data/provider: gemini
    ⫻data/model: gemini-3.7-flash
    ⫻data/prompt: In one sentence, what is the OCS Display protocol surface?
    ⫻flow/nexus: t482-ocs-qml6 live llm
